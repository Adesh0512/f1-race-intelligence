            {
              "field": {
                "Aggregation": {
                  "Expression": {
                    "Column": {
                      "Expression": {
                        "SourceRef": {
                          "Entity": "Association_Rules"
                        }
                      },
                      "Property": "lift"
                    }
                  },
                  "Function": 0
                }
              },
              "queryRef": "Sum(Association_Rules.lift)",
              "nativeQueryRef": "Sum of lift"
