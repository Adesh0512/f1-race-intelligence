          ]
        },
        "X": {
          "projections": [
            {
              "field": {
                "Aggregation": {
                  "Expression": {
                    "Column": {
                      "Expression": {
                        "SourceRef": {
                          "Entity": "Association_Rules"
                        }
                      },
                      "Property": "support"
                    }
                  },
                  "Function": 0
                }
              },
              "queryRef": "Sum(Association_Rules.support)",
              "nativeQueryRef": "Sum of support"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Aggregation": {
                  "Expression": {
                    "Column": {
                      "Expression": {
                        "SourceRef": {
                          "Entity": "Association_Rules"
                        }
                      },
                      "Property": "confidence"
                    }
                  },
                  "Function": 0
                }
              },
              "queryRef": "Sum(Association_Rules.confidence)",
              "nativeQueryRef": "Sum of confidence"
            }
          ]
        },
        "Size": {
