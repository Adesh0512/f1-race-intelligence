table Forecast_2025
	lineageTag: 40e41afa-78a7-4963-8761-5ba8996da00f

	measure 'Forecast Winner' = IF(HASONEVALUE(Forecast_2025[race]), CALCULATE(MAX(Forecast_2025[driver_name]), Forecast_2025[predicted_rank] = 1), "Pick one race")
		lineageTag: ca3a4cdd-1078-4ed4-b3b9-250a69a67625

	measure 'Forecast Win %' = IF(HASONEVALUE(Forecast_2025[race]), CALCULATE(MAX(Forecast_2025[win_probability]), Forecast_2025[predicted_rank] = 1))
		formatString: 0.0
		lineageTag: 0183bd70-24d6-4705-a3f3-45a5e7e38d53

	measure 'Main Rival' = IF(HASONEVALUE(Forecast_2025[race]), CALCULATE(MAX(Forecast_2025[driver_name]), Forecast_2025[predicted_rank] = 2), "Pick one race")
		lineageTag: d6e27cc6-68c1-474f-9ce3-9ae8a7f6cc25

	measure 'Expected Wins' = SUM(Forecast_2025[win_probability]) / 100
		formatString: 0.0
		lineageTag: 5150ccd8-3bec-47cf-a594-b68747766824

	measure 'Races Forecast' = DISTINCTCOUNT(Forecast_2025[round])
		formatString: 0
		lineageTag: f8ddbf5a-379c-4be2-a22e-bc45f075a5b1

