table Fact_Race_Results
	lineageTag: c495ce16-263a-4287-912f-8c58007882ee

	measure 'Race Results' = COUNTROWS(Fact_Race_Results)
		formatString: #,0
		lineageTag: 341aba9b-49ee-4692-b1c0-2d2fbba91432

	measure 'Wins' = SUM(Fact_Race_Results[is_win])
		formatString: 0
		lineageTag: e66f764f-86f8-43c7-8edd-6d63f29f6bd6

	measure 'Podiums' = SUM(Fact_Race_Results[is_podium])
		formatString: 0
		lineageTag: 622445eb-5c2d-4a06-bc7a-e71688d05891

	measure 'Win Rate %' = DIVIDE([Wins], [Race Results]) * 100
		formatString: 0.0
		lineageTag: 5567f5d2-8edb-4a51-9d84-55df11e1050a

	measure 'Drivers' = DISTINCTCOUNT(Fact_Race_Results[driver_id])
		formatString: 0
		lineageTag: df7d3752-71e4-4a4a-885d-74810990d12b

	measure 'Teams' = DISTINCTCOUNT(Fact_Race_Results[constructor_id])
		formatString: 0
		lineageTag: 611f1700-4c78-4a53-ab79-afa379537104

