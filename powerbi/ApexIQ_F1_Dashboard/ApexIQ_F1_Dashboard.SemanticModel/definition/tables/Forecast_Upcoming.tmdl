table Forecast_Upcoming
	lineageTag: 868aaf0e-d2bd-4cc8-acef-aa4cf0d24947

	measure 'Forecast Winner' = IF(HASONEVALUE(Forecast_Upcoming[race]), CALCULATE(MAX(Forecast_Upcoming[driver_name]), Forecast_Upcoming[predicted_rank] = 1), "Pick one race")
		lineageTag: 0ce7881d-7650-44d1-b6f2-b353189da3b3

	measure 'Forecast Win %' = IF(HASONEVALUE(Forecast_Upcoming[race]), CALCULATE(MAX(Forecast_Upcoming[win_probability]), Forecast_Upcoming[predicted_rank] = 1))
		formatString: 0.0
		lineageTag: 1a37820c-6259-4a66-a783-043f414b9d01

	measure 'Main Rival' = IF(HASONEVALUE(Forecast_Upcoming[race]), CALCULATE(MAX(Forecast_Upcoming[driver_name]), Forecast_Upcoming[predicted_rank] = 2), "Pick one race")
		lineageTag: 389ff77c-136e-4afa-af18-4512b9a94bd1

	measure 'Expected Wins' = SUM(Forecast_Upcoming[win_probability]) / 100
		formatString: 0.0
		lineageTag: 2be704ef-536d-4276-aa0f-a62230ec3ff5

	measure 'Races Forecast' = DISTINCTCOUNT(Forecast_Upcoming[round])
		formatString: 0
		lineageTag: d2e55be3-0030-49ab-9bf6-357f2d088358

	column 'season'
