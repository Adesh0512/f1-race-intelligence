table Forecast_Upcoming
	lineageTag: 55f41061-d817-4127-8842-34cf7e644c51

	measure 'Selected Race' = IF(HASONEVALUE(Forecast_Upcoming[race]), VALUES(Forecast_Upcoming[race]), "Qatar Grand Prix, 29 Nov 2026")
		lineageTag: 2589003d-40c1-4d26-96c4-dadda85dea44

	measure 'Selected Pole' = IF(HASONEVALUE(Forecast_Upcoming[pole_scenario]), VALUES(Forecast_Upcoming[pole_scenario]), "Projected grid (Andrea Kimi Antonelli on pole)")
		lineageTag: 30086f33-aef5-4aa8-b1f8-94cd230c9771

	measure 'Last Race Winner' = MAX(Forecast_Upcoming[last_race])
		lineageTag: 44b6f46d-605d-48c2-a88d-598e02cd7c11

	measure 'Forecast Winner' = VAR r = [Selected Race] VAR p = [Selected Pole] RETURN CALCULATE(MAX(Forecast_Upcoming[driver_name]), Forecast_Upcoming[race] = r, Forecast_Upcoming[pole_scenario] = p, Forecast_Upcoming[predicted_rank] = 1)
		lineageTag: 74013b16-aca0-4f38-971b-b0e2f812028f

	measure 'Forecast Win %' = VAR r = [Selected Race] VAR p = [Selected Pole] RETURN CALCULATE(MAX(Forecast_Upcoming[win_probability]), Forecast_Upcoming[race] = r, Forecast_Upcoming[pole_scenario] = p, Forecast_Upcoming[predicted_rank] = 1)
		formatString: 0.0
		lineageTag: 50f3b468-ef7e-4307-b466-2cd50b566626

	measure 'Main Rival' = VAR r = [Selected Race] VAR p = [Selected Pole] RETURN CALCULATE(MAX(Forecast_Upcoming[driver_name]), Forecast_Upcoming[race] = r, Forecast_Upcoming[pole_scenario] = p, Forecast_Upcoming[predicted_rank] = 2)
		lineageTag: 7db419a5-f820-4810-a92c-c4cb18b6f70e

	measure 'Win Chance %' = VAR r = [Selected Race] VAR p = [Selected Pole] RETURN CALCULATE(AVERAGE(Forecast_Upcoming[win_probability]), Forecast_Upcoming[race] = r, Forecast_Upcoming[pole_scenario] = p)
		formatString: 0.0
		lineageTag: 59fa3501-6a9c-4fb1-85e4-5ad62a065d6e

	measure 'Predicted Position' = VAR r = [Selected Race] VAR p = [Selected Pole] RETURN CALCULATE(MIN(Forecast_Upcoming[predicted_rank]), Forecast_Upcoming[race] = r, Forecast_Upcoming[pole_scenario] = p)
		formatString: 0
		lineageTag: dca91350-ae64-4001-8559-bfaa948730db

	measure 'Starting Position' = VAR r = [Selected Race] VAR p = [Selected Pole] RETURN CALCULATE(MIN(Forecast_Upcoming[grid_position]), Forecast_Upcoming[race] = r, Forecast_Upcoming[pole_scenario] = p)
		formatString: 0
		lineageTag: 6d2caaa5-f996-46d0-ab11-4cff242a612a

	measure 'Avg Finish Last 5' = VAR r = [Selected Race] VAR p = [Selected Pole] RETURN CALCULATE(AVERAGE(Forecast_Upcoming[driver_rolling_finish_5]), Forecast_Upcoming[race] = r, Forecast_Upcoming[pole_scenario] = p)
		formatString: 0.0
		lineageTag: f37b0818-7f3d-4046-a5f5-70b42daf6542

	measure 'Team Points Per Race' = VAR r = [Selected Race] VAR p = [Selected Pole] RETURN CALCULATE(AVERAGE(Forecast_Upcoming[constructor_rolling_points_10]), Forecast_Upcoming[race] = r, Forecast_Upcoming[pole_scenario] = p)
		formatString: 0.0
		lineageTag: bae970d8-ba21-4cf9-a56c-4bcd952c347b

	measure 'Starts At Track' = VAR r = [Selected Race] VAR p = [Selected Pole] RETURN CALCULATE(MIN(Forecast_Upcoming[circuit_experience]), Forecast_Upcoming[race] = r, Forecast_Upcoming[pole_scenario] = p)
		formatString: 0
		lineageTag: 1b7bd53d-c72c-4210-be97-79953f3300b5

	measure 'Career Win Pct' = VAR r = [Selected Race] VAR p = [Selected Pole] RETURN CALCULATE(AVERAGE(Forecast_Upcoming[career_win_rate]), Forecast_Upcoming[race] = r, Forecast_Upcoming[pole_scenario] = p)
		formatString: 0.0
		lineageTag: 52552459-0213-40b5-85e8-ac08f0fd96bf

