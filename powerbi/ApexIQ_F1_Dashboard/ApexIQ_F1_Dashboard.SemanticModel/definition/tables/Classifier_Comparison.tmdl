table Classifier_Comparison
	lineageTag: 70e7fbd6-2cd0-4e66-a95c-f30096593b9c

	measure 'Champion ROC-AUC' = CALCULATE(SUM(Classifier_Comparison[roc_auc]), CONTAINSSTRING(Classifier_Comparison[model], "Champion"))
		formatString: 0.0000
		lineageTag: f85cec7a-c4e7-4509-afba-12eb113b9497

	measure 'Models' = COUNTROWS(Classifier_Comparison)
		formatString: 0
		lineageTag: cd2b43f3-93d7-4524-8a79-72c4855a85ff

	measure 'Best ROC-AUC' = MAX(Classifier_Comparison[roc_auc])
		formatString: 0.0000
		lineageTag: 7c4a51a5-bd97-4ced-b7d1-3db3a12b8d5b

	measure 'Best Winner Pick %' = MAX(Classifier_Comparison[top1_winner_hit_pct])
		formatString: 0.0
		lineageTag: 1eb9a718-abac-464f-b35d-d4456c48d0b3

	column 'model'
		dataType: string
		lineageTag: 7eb19ec9-b3db-4cc5-8666-786837a051c5
		summarizeBy: none
		sourceColumn: model

	column 'roc_auc'
		dataType: double
		lineageTag: ee18193a-f859-42e7-ab1a-1f7b8a61a3c9
		summarizeBy: none
		sourceColumn: roc_auc

	column 'pr_auc'
		dataType: double
		lineageTag: b3fb5939-cf89-4fc5-bbb0-3b71ed2b80d7
		summarizeBy: none
		sourceColumn: pr_auc

	column 'recall'
		dataType: double
		lineageTag: 61aaf6bb-fd60-4343-ab67-fd5e5bf9cc7b
		summarizeBy: none
		sourceColumn: recall

	column 'top1_winner_hit_pct'
		dataType: double
		lineageTag: ae00df72-9d1d-4078-b304-81605d27890a
		summarizeBy: none
		sourceColumn: top1_winner_hit_pct

	column 'top3_podium_hit_pct'
		dataType: double
		lineageTag: eae6982c-4000-4498-b8ee-174b26b2aca4
		summarizeBy: none
		sourceColumn: top3_podium_hit_pct

	partition Classifier_Comparison = m
		mode: import
		source =
				let
					Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [model = _t, roc_auc = _t, pr_auc = _t, recall = _t, top1_winner_hit_pct = _t, top3_podium_hit_pct = _t]),
					#"Changed Type" = Table.TransformColumnTypes(Source, {{"model", type text}, {"roc_auc", type number}, {"pr_auc", type number}, {"recall", type number}, {"top1_winner_hit_pct", type number}, {"top3_podium_hit_pct", type number}}, "en-US")
				in
					#"Changed Type"

	annotation PBI_ResultType = Table
