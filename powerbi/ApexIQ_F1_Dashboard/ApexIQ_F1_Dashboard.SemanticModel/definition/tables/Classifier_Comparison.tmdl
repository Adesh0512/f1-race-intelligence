table Classifier_Comparison
	lineageTag: 45ce594f-a55c-4cfc-bfa1-4779c4adc05b

	measure 'Champion ROC-AUC' = CALCULATE(SUM(Classifier_Comparison[roc_auc]), CONTAINSSTRING(Classifier_Comparison[model], "Champion"))
		formatString: 0.0000
		lineageTag: a5fe2b0b-2dfb-4347-9ccc-cb768d18df54

	measure 'Models' = COUNTROWS(Classifier_Comparison)
		formatString: 0
		lineageTag: 5a573c64-8def-4810-b8d8-0a04350a7ebb

	measure 'Best ROC-AUC' = MAX(Classifier_Comparison[roc_auc])
		formatString: 0.0000
		lineageTag: fd09439f-a91e-43b6-8ecf-64b4fa0604c6

	measure 'Best Winner Pick %' = MAX(Classifier_Comparison[top1_winner_hit_pct])
		formatString: 0.0
		lineageTag: 15fdd13a-0ab5-46d1-9491-0f311c80d7fd

	column 'model'
		dataType: string
		lineageTag: f3a6dc91-fd84-44c1-b6fd-2cc2c3a4aeaf
		summarizeBy: none
		sourceColumn: model

	column 'roc_auc'
		dataType: double
		lineageTag: 5de6b87c-7019-46fe-9e70-77b88c91dd1f
		summarizeBy: none
		sourceColumn: roc_auc

	column 'pr_auc'
		dataType: double
		lineageTag: 09d93522-89a8-40d8-a6c1-8818068a9c53
		summarizeBy: none
		sourceColumn: pr_auc

	column 'recall'
		dataType: double
		lineageTag: bbb04ac1-99cd-4055-80af-9051e058892a
		summarizeBy: none
		sourceColumn: recall

	column 'top1_winner_hit_pct'
		dataType: double
		lineageTag: e4781777-db19-49c0-84a6-8f03c9996c28
		summarizeBy: none
		sourceColumn: top1_winner_hit_pct

	column 'top3_podium_hit_pct'
		dataType: double
		lineageTag: 4fccc412-51ec-4dd6-9dee-a44a4e31d1cc
		summarizeBy: none
		sourceColumn: top3_podium_hit_pct

	partition Classifier_Comparison = m
		mode: import
		source =
				let
					Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [model = _t, roc_auc = _t, pr_auc = _t, recall = _t, top1_winner_hit_pct = _t, top3_podium_hit_pct = _t]),
					#"Changed Type" = Table.TransformColumnTypes(Source, {{"model", type text}, {"roc_auc", type number}, {"pr_auc", type number}, {"recall", type number}, {"top1_winner_hit_pct", type number}, {"top3_podium_hit_pct", type number}}, "en-US")
				in
