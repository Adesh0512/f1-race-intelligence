table Classifier_Comparison
	lineageTag: 585c2f52-6def-47e6-a2d5-e77f53f3c6ef

	measure 'Champion ROC-AUC' = CALCULATE(SUM(Classifier_Comparison[roc_auc]), CONTAINSSTRING(Classifier_Comparison[model], "Champion"))
		formatString: 0.0000
		lineageTag: a4c6e190-374a-4d26-b11a-94edf7e1bdb9

	measure 'Models' = COUNTROWS(Classifier_Comparison)
		formatString: 0
		lineageTag: 5340744c-fe38-4dec-a714-d02d77c7be86

	measure 'Best ROC-AUC' = MAX(Classifier_Comparison[roc_auc])
		formatString: 0.0000
		lineageTag: 71820df5-f3ba-4cb4-ba3a-fcce6234b80f

	measure 'Best Winner Pick %' = MAX(Classifier_Comparison[top1_winner_hit_pct])
		formatString: 0.0
		lineageTag: 0d41547f-c1cf-453b-ba1b-d12c33f57a14

	column 'model'
