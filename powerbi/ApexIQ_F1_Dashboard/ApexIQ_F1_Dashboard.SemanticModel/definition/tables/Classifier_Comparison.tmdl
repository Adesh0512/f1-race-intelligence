table Classifier_Comparison
	lineageTag: 20e7b914-5d6f-41d9-a602-8755e296458e

	measure 'Champion ROC-AUC' = CALCULATE(SUM(Classifier_Comparison[roc_auc]), CONTAINSSTRING(Classifier_Comparison[model], "Champion"))
		formatString: 0.0000
		lineageTag: 982d26b3-856d-489d-87d9-03587e26cb94

	measure 'Models' = COUNTROWS(Classifier_Comparison)
		formatString: 0
		lineageTag: 98cc36ed-a7fc-4176-8188-dacdbbb299c9

	measure 'Best ROC-AUC' = MAX(Classifier_Comparison[roc_auc])
		formatString: 0.0000
		lineageTag: 4a19d84c-fdc8-4455-841a-4b3d2525eaf7

	measure 'Best Winner Pick %' = MAX(Classifier_Comparison[top1_winner_hit_pct])
		formatString: 0.0
		lineageTag: 8b02bf80-40bd-4f6a-9c1c-dc0ebbdd80c3

	column 'model'
		dataType: string
		lineageTag: cf3d04c3-e0be-49fd-9fe7-994562bf852a
