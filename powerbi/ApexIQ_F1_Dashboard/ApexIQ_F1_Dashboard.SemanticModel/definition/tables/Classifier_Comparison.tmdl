	partition Classifier_Comparison = m
		mode: import
		source =
				let
					Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [model = _t, roc_auc = _t, pr_auc = _t, recall = _t, top1_winner_hit_pct = _t, top3_podium_hit_pct = _t]),
