		sourceColumn: model

	column 'roc_auc'
		dataType: double
		lineageTag: ef5241e5-d441-4cc6-aedf-8815eb591ec4
		summarizeBy: none
		sourceColumn: roc_auc

	column 'pr_auc'
		dataType: double
		lineageTag: 3ce6b001-65e6-4c40-83c3-79a00d17bdaf
		summarizeBy: none
		sourceColumn: pr_auc

	column 'recall'
		dataType: double
		lineageTag: 8180056c-d48f-401e-b866-7f475e732fb2
		summarizeBy: none
		sourceColumn: recall

	column 'top1_winner_hit_pct'
		dataType: double
		lineageTag: eb19ff5e-e82e-4325-b2f9-202bcdb4a317
		summarizeBy: none
		sourceColumn: top1_winner_hit_pct

	column 'top3_podium_hit_pct'
		dataType: double
		lineageTag: 8c6f4b5f-236c-49f4-a760-0cb691c691c4
		summarizeBy: none
		sourceColumn: top3_podium_hit_pct

	partition Classifier_Comparison = m
		mode: import
		source =
				let
					Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [model = _t, roc_auc = _t, pr_auc = _t, recall = _t, top1_winner_hit_pct = _t, top3_podium_hit_pct = _t]),
					#"Changed Type" = Table.TransformColumnTypes(Source, {{"model", type text}, {"roc_auc", type number}, {"pr_auc", type number}, {"recall", type number}, {"top1_winner_hit_pct", type number}, {"top3_podium_hit_pct", type number}}, "en-US")
				in
