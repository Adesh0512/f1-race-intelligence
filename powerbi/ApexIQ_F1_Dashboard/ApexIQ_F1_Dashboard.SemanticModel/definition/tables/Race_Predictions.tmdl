table Race_Predictions
	lineageTag: 8a63358f-2241-4df6-b2b9-8e02fc16f126

	measure 'Grands Prix' = DISTINCTCOUNT(Race_Predictions[race_id])
		formatString: 0
		lineageTag: 73e803bd-b796-4d3e-b840-1a1f11d16958

	measure 'Gauge Max' = 100
		formatString: 0
		lineageTag: d414dddb-532e-42bb-88fa-3a9c03d2d3c9

	measure 'Pole Baseline %' = 51.47
		formatString: 0.0
		lineageTag: 73980d24-9416-4ef4-ab5e-a479fa846694

	measure 'Predicted Winner' = IF(HASONEVALUE(Race_Predictions[race]), CALCULATE(MAX(Race_Predictions[driver_name]), Race_Predictions[predicted_rank] = 1), "Pick one race")
		lineageTag: 69055ad1-b0b3-42f6-b281-53f68c982be0

	measure 'Predicted Win %' = IF(HASONEVALUE(Race_Predictions[race]), CALCULATE(MAX(Race_Predictions[win_probability_pct]), Race_Predictions[predicted_rank] = 1))
		formatString: 0.0
		lineageTag: 055f2861-69de-46de-b0a7-ea63df36a358

	measure 'Actual Winner' = IF(HASONEVALUE(Race_Predictions[race]), CALCULATE(MAX(Race_Predictions[driver_name]), Race_Predictions[target_is_win] = 1), "Pick one race")
		lineageTag: c34c5547-eb9e-4cb6-bee9-323085d50dc6

	measure 'Prediction Result' = IF(HASONEVALUE(Race_Predictions[race]), IF([Predicted Winner] = [Actual Winner], "Correct", "Missed"), "Pick one race")
		lineageTag: 2a9b181f-3b08-43be-970b-0966a3cc9639

	measure 'Winners Picked' = SUM(Race_Predictions[is_winner_hit])
		formatString: 0
		lineageTag: f27a3844-da9d-491d-abcb-953a31a304a7

	measure 'Winner Hit Rate %' = DIVIDE([Winners Picked], [Grands Prix]) * 100
		formatString: 0.0
		lineageTag: 02550cb6-717c-4792-83e6-c810d94a90ed

	measure 'Winner In Top 3 %' = DIVIDE(SUM(Race_Predictions[winner_in_top3]), [Grands Prix]) * 100
		formatString: 0.0
		lineageTag: 976aed26-c3b6-460f-9bc2-c382fd16e96c

